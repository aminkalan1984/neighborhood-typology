{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeasurementValue",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "indicator_code": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ],
      "description": "عدد فقط وقتی status=OBSERVED/ESTIMATED/PROXY؛ در غیر این صورت null. هرگز صفرِ ساختگی."
    },
    "status": {
      "enum": [
        "OBSERVED",
        "MISSING",
        "NOT_APPLICABLE",
        "INVALID",
        "ESTIMATED",
        "PROXY",
        "INSUFFICIENT_COVERAGE",
        "WAITING_FOR_DATA",
        "SOURCE_UNAVAILABLE",
        "ACCESS_REQUIRED",
        "PENDING_VALIDATION"
      ]
    },
    "is_proxy": {
      "type": "boolean"
    },
    "missing_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "spatial_scale": {
      "type": [
        "string",
        "null"
      ]
    },
    "downscaling_caveat": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_stream": {
      "type": "array",
      "items": {
        "enum": [
          "objective",
          "gis",
          "behavioral",
          "perceptual"
        ]
      }
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "group": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "indicator_code",
    "value",
    "status",
    "is_proxy"
  ]
}
[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Development-only backend target used by the Vite /api proxy.
ARA_API_PROXY_TARGET="http://localhost:4001"

# Optional public API origin for builds where the UI and API are deployed separately.
VITE_API_BASE_URL=""

# ===== سینا — دستیار هوشمند (Anthropic-compatible / tabitoken) =====
# مقادیر واقعی را در .env.local بگذارید (این فایل در مخزن ثبت می‌شود؛ آن‌جا نه).
# پیشوند ARA_ از تداخل با متغیرهای سراسری ANTHROPIC_* جلوگیری می‌کند.
# ARA_ANTHROPIC_API_KEY: کلید API سرویس سازگار با Anthropic Messages.
#   فقط در سمت سرور (پراکسی vite) خوانده می‌شود و وارد باندل فرانت‌اند نمی‌شود.
ARA_ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"
# ARA_ANTHROPIC_BASE_URL: پایه‌ی آدرس API (بدون "/v1/messages").
ARA_ANTHROPIC_BASE_URL="https://tabitoken.com"
# VITE_ANTHROPIC_MODEL: نام مدل مورد استفاده.
VITE_ANTHROPIC_MODEL="claude-opus-5-thinking"
